        <div class="identidad">
            <span class="marca">Simulador de Procesos</span>
            <span class="subtitulo">Round Robin · Modelo de estados</span>
        </div>
        <nav class="navegacion" aria-label="Principal">
            <NavLink class="enlace-nav" ActiveClass="activo" href="" Match="NavLinkMatch.All">Simulación</NavLink>
            <NavLink class="enlace-nav" ActiveClass="activo" href="reportes">Reportes</NavLink>
        </nav>
    </div>
</header>

<main id="contenido" class="contenido" tabindex="-1">
    @Body
</main>
