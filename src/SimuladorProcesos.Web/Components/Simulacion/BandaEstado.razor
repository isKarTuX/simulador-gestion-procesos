@* Banda horizontal de un estado. Parámetros congelados (los usa la página de simulación). *@

@{
    // Se materializa una vez: Procesos puede ser una consulta diferida (p. ej. la vista Espera).
    var lista = Procesos as IReadOnlyList<ProcesoInstantanea> ?? [.. Procesos];
}

<section class="banda @Clase" aria-labelledby="@_idTitulo">
    <header class="banda-cabecera">
        <h2 id="@_idTitulo">@Titulo</h2>
        <span class="contador" title="Procesos en esta banda">@lista.Count</span>
    </header>

    <div class="banda-procesos">
        @if (lista.Count == 0)
        {
            <p class="vacia">Sin procesos</p>
        }
        else
        {
            @foreach (var proceso in lista)
            {
                <TarjetaProceso @key="proceso.Pid" Proceso="proceso" />
            }
        }
    </div>
</section>

@code {
    // Id único por instancia: la misma clase puede aparecer más de una vez en una página.
    private readonly string _idTitulo = $"banda-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Titulo { get; set; } = string.Empty;

    /// <summary>listos | ejecucion | espera | terminado</summary>
    [Parameter, EditorRequired]
    public string Clase { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IEnumerable<ProcesoInstantanea> Procesos { get; set; } = [];
}
