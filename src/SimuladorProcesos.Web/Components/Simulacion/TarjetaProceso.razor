@* Tarjeta verde del enunciado. Parámetros congelados; estilo: subtarea 1.11. *@

<div class="tarjeta-proceso">
    <strong>Procesos @Proceso.Numero</strong>
    <span>Pid: @Proceso.Pid</span>
    <span>Quantum: @Proceso.Quantum</span>
