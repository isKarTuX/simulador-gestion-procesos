<UserControl x:Class="SimuladorProcesos.Desktop.Vistas.CatalogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SimuladorProcesos.Desktop;component/Recursos/Estilos.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Muestra el texto de error solo cuando hay uno, pero conserva la altura (MinHeight del estilo). -->
      <Style x:Key="MensajeEstado" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoSuaveBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding MensajeEsError}" Value="True">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{StaticResource FondoBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Encabezado, con el mismo tono que la Web. -->
    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Simulador de Procesos" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AcentoBrush}" />
        <TextBlock Text="App 1 · Generador de catálogos" Margin="12,0,0,0" VerticalAlignment="Bottom"
                   Foreground="{StaticResource TextoSuaveBrush}" />
      </StackPanel>
    </Border>

    <!-- Formulario: los campos se bloquean mientras hay una operación en curso; los botones deciden solos con CanExecute. -->
    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="16,16,16,8">
      <StackPanel>
        <Grid IsEnabled="{Binding NoOcupado}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,16,0" Width="110">
            <TextBlock Text="Cantidad de procesos (N)" Style="{StaticResource Etiqueta}" />
            <TextBox Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding ErrorCantidad}" Style="{StaticResource TextoError}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="0,0,16,0" Width="130">
            <TextBlock Text="Criterio" Style="{StaticResource Etiqueta}" />
            <ComboBox ItemsSource="{Binding Criterios}"
                      DisplayMemberPath="Texto"
                      SelectedValuePath="Valor"
                      SelectedValue="{Binding Criterio}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Margin="0,0,16,0" Width="150">
            <DockPanel>
              <TextBlock Text="Número" Style="{StaticResource Etiqueta}" DockPanel.Dock="Left" />
              <CheckBox Content="Consecutivo" IsChecked="{Binding UsarConsecutivo}" HorizontalAlignment="Right"
                        FontSize="12" Foreground="{StaticResource TextoSuaveBrush}" />
            </DockPanel>
            <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NumeroEditable}" />
            <TextBlock Text="{Binding ErrorNumero}" Style="{StaticResource TextoError}" />
          </StackPanel>

          <StackPanel Grid.Column="3" Margin="0,0,16,0">
            <TextBlock Text="Nombre del catálogo" Style="{StaticResource Etiqueta}" />
            <TextBox Text="{Binding NombreCatalogo, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding ErrorNombre}" Style="{StaticResource TextoError}" />
          </StackPanel>

          <StackPanel Grid.Column="4" Width="110">
            <TextBlock Text="TH (ms por carácter)" Style="{StaticResource Etiqueta}" />
            <TextBox Text="{Binding ThMs, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding ErrorTh}" Style="{StaticResource TextoError}" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Capturar" Command="{Binding CapturarCommand}" Style="{StaticResource BotonPrimario}" />
          <Button Content="Guardar catálogo" Command="{Binding GuardarCommand}" Style="{StaticResource BotonPrimario}" Margin="8,0,0,0" />
          <Button Content="Ejecutar actividad" Command="{Binding EjecutarActividadCommand}" Style="{StaticResource BotonSecundario}" Margin="8,0,0,0" />
          <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource BotonPeligro}" Margin="8,0,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Listado de procesos y panel de catálogos guardados. -->
    <Grid Grid.Row="2" Margin="16,8,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,12">
            <TextBlock Text="Procesos" Style="{StaticResource TituloSeccion}" />
            <TextBlock Text="{Binding ResumenProcesos}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource TextoSuaveBrush}" />
          </DockPanel>

          <Grid>
            <DataGrid ItemsSource="{Binding Procesos}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BordeBrush}"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{StaticResource BordeBrush}"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="{StaticResource FilaAlternaBrush}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeight="30">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Pid" Binding="{Binding Pid}" Width="70" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="140" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="190" />
                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                <DataGridTextColumn Header="Prioridad" Binding="{Binding Prioridad}" Width="120" />
                <DataGridTemplateColumn Header="Actividad" Width="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid>
                        <ProgressBar Minimum="0" Maximum="100" Height="16"
                                     Value="{Binding ProgresoActividad, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgresoActividad, StringFormat={}{0:0}%}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                                   Foreground="{StaticResource TextoBrush}" />
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Define N y el criterio, y pulsa Capturar para ver los procesos aquí."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextoSuaveBrush}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HayProcesos}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Catálogos guardados" Style="{StaticResource TituloSeccion}" Margin="16,12" />
          <Grid>
            <ListBox ItemsSource="{Binding CatalogosGuardados}"
                     SelectedItem="{Binding CatalogoSeleccionado}"
                     IsEnabled="{Binding NoOcupado}"
                     BorderThickness="0,1,0,0"
                     BorderBrush="{StaticResource BordeBrush}"
                     HorizontalContentAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,4">
                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detalle}" FontSize="11" Foreground="{StaticResource TextoSuaveBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Aún no hay catálogos guardados."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource TextoSuaveBrush}"
                       Visibility="{Binding SinCatalogos, Converter={StaticResource BoolAVisibilidad}}" />
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Barra de estado. -->
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" IsIndeterminate="True"
                     Visibility="{Binding Ocupado, Converter={StaticResource BoolAVisibilidad}}" />
        <TextBlock Text="{Binding Mensaje}" Style="{StaticResource MensajeEstado}" Margin="0,0,16,0" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
