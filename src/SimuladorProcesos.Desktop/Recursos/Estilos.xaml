<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Paleta alineada con la Web (wwwroot/app.css): verde #138a13 como acento, grises sobrios. -->
  <SolidColorBrush x:Key="AcentoBrush" Color="#138A13" />
  <SolidColorBrush x:Key="AcentoOscuroBrush" Color="#0E6A0E" />
  <SolidColorBrush x:Key="FondoBrush" Color="#FAFAFA" />
  <SolidColorBrush x:Key="TarjetaBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BordeBrush" Color="#E3E3E3" />
  <SolidColorBrush x:Key="TextoBrush" Color="#1D1D1F" />
  <SolidColorBrush x:Key="TextoSuaveBrush" Color="#6B6B6B" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#D93636" />
  <SolidColorBrush x:Key="FilaAlternaBrush" Color="#F6F8F6" />
  <SolidColorBrush x:Key="SeleccionBrush" Color="#E3F2E3" />

  <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />

  <!-- Etiqueta encima de cada campo del formulario. -->
  <Style x:Key="Etiqueta" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextoSuaveBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Mensaje de validación bajo el campo; reserva su altura para que el formulario no salte. -->
  <Style x:Key="TextoError" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="TituloSeccion" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
  </Style>

  <Style x:Key="Tarjeta" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource TarjetaBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderBrush" Value="#BDBDBD" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="#F0F0F0" />
        <Setter Property="Foreground" Value="#8A8A8A" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Height" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Botón con esquinas redondeadas; Primario = verde de acento, Secundario = contorno. -->
  <Style x:Key="BotonBase" TargetType="Button">
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="MinWidth" Value="110" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Marco"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Marco" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Marco" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
    <Setter Property="Background" Value="{StaticResource AcentoBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AcentoBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource AcentoBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AcentoBrush}" />
  </Style>

  <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
  </Style>

  <!-- Tabla de procesos. -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F1F4F1" />
    <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource SeleccionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextoBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AcentoBrush}" />
    <Setter Property="Background" Value="#E4E9E4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

</ResourceDictionary>
